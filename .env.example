# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Passcode editors type on the /admin sign-in screen.
# While unset the panel accepts a development default and shows a warning banner.
ADMIN_PASSCODE=""

# Signs/encrypts the admin session cookie. Use >= 32 random characters.
# Changing it signs every editor out.
SESSION_SECRET=""

# MySQL / MariaDB connection string. Without it the site runs on in-memory
# content: edits work but are lost when the server restarts.
# Hostinger: the database host is usually "localhost" on the server itself.
# Connecting from your machine additionally requires adding your IP under
# hPanel -> Databases -> Remote MySQL.
DATABASE_URL="mysql://user:password@localhost:3306/database"
